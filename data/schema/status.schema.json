{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://livecam-jp/schema/status.schema.json",
 "title": "StatusFile",
 "type": "object",
 "required": [
  "generated_at",
  "statuses"
 ],
 "properties": {
  "generated_at": {
   "type": "string",
   "format": "date-time"
  },
  "statuses": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "state"
    ],
    "properties": {
     "state": {
      "type": "string",
      "enum": [
       "ok",
       "frozen",
       "error",
       "unknown"
      ]
     },
     "last_ok_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "http_status": {
      "type": [
       "integer",
       "null"
      ]
     },
     "frozen_since": {
      "type": [
       "string",
       "null"
      ]
     },
     "consecutive_failures": {
      "type": "integer",
      "minimum": 0
     },
     "avg_interval_sec": {
      "type": [
       "integer",
       "null"
      ]
     },
     "image_url": {
      "type": [
       "string",
       "null"
      ],
      "description": "都度解決型feed（mlit_roadinfo等）の最新静止画URL。monitorが実行のたびに再解決する"
     },
     "image_time": {
      "type": [
       "string",
       "null"
      ],
      "description": "image_url の画像取得時刻（提供元申告）"
     }
    }
   }
  }
 }
}